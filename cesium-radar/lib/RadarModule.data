precision highp float;
precision highp int;
precision highp sampler2D;

#ifdef USE_UBO
#define UNIFORM_DECL_PREFIX
#else
#define UNIFORM_DECL_PREFIX uniform
#endif

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
#define SAMPLER_DECL_PREFIX
#else
#define SAMPLER_DECL_PREFIX uniform
#endif

#define MAGNETICS_PI  3.14159265
#define MAGNETICS_2PI 6.28318548

#define DTOR  0.017453292
#define RTOD  57.295780490

struct RadarDisturbMsg {
    float Pj;//е№Іж‰°жњєеЏ‘е°„еЉџзЋ‡
	float Gj;//е№Іж‰°жњєзљ„еЏ‘е°„еўћз›Љ
	float Bj;//е№Іж‰°жњєиї›е…Ґй›·иѕѕе¤©зєїзљ„дїЎеЏ·её¦е®Ѕ
	float Yj;//дёєй›·иѕѕе¤©зєїжЋҐж”¶е№Іж‰°жњєдїЎеЏ·зљ„жћЃеЊ–жЌџиЂ—
	float Kj;//дёєжЊ‡е®љзљ„еЋ‹е€¶зі»ж•°
	float K;//дёєй›·иѕѕе¤©зєїзљ„ж–№еђ‘жЂ§зі»ж•°0.04-0.1
	float Theta_Half;// й›·иѕѕеЌЉеЉџзЋ‡жіўжќџе®Ѕеє¦ еЌ•дЅЌеє¦
	vec3 Pos; //дЅЌзЅ®
};
	
#if defined(USE_UBO)
layout(std140) uniform trit_ShaderParameters_UBO {
#endif

    // These are used in the vertex shader
    UNIFORM_DECL_PREFIX mat4 ModelMatrix;
    UNIFORM_DECL_PREFIX mat4 ViewMatrix;
    UNIFORM_DECL_PREFIX mat4 ProjectionMatrix;
    UNIFORM_DECL_PREFIX bool EnableLogDepth;
    UNIFORM_DECL_PREFIX vec2 CurrentFrustum;
    UNIFORM_DECL_PREFIX float FarDepthFromNearPlusOne;
    UNIFORM_DECL_PREFIX float OneOverLog2FarDepthFromNearPlusOne;
	
	UNIFORM_DECL_PREFIX vec4 Pt_Gt_lanBuda_thegema;
	UNIFORM_DECL_PREFIX vec4 N_K_Bn_Fn;
	UNIFORM_DECL_PREFIX vec3 SDeltaN_T0_GridStepAngle;
	UNIFORM_DECL_PREFIX vec4 AZS_AZE_PitchS_PitchE;
	UNIFORM_DECL_PREFIX vec4 MissParameter_Radius_Pos;
	
	UNIFORM_DECL_PREFIX vec2 BRadarFlatLoc_BlendColor;
	UNIFORM_DECL_PREFIX vec4 UniformColor;
	UNIFORM_DECL_PREFIX vec3 LightDir;
	UNIFORM_DECL_PREFIX vec4 LightColor;

	UNIFORM_DECL_PREFIX vec4 AntenaLobe;
	UNIFORM_DECL_PREFIX vec4 AntenaCfg;
	
	UNIFORM_DECL_PREFIX int NumDisturb;

	UNIFORM_DECL_PREFIX RadarDisturbMsg Radar_DisturbMsgs[MAX_DISTURB];
    	
#if defined(USE_UBO)
};
#endif

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
layout(std140) uniform trit_TextureHandles_UBO {
#endif
  SAMPLER_DECL_PREFIX sampler2D radar_ColorTable;

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
};
#endif


in float v_depthFromNearPlusOne;
in vec2  v_textCoord;
in vec2  v_AZ_PitchR;
in vec3  v_Normal;

out vec4 out_FragColor;
 
void writeLogDepth(float depth)
{
   if (depth <= 0.9999999 || depth > FarDepthFromNearPlusOne) {
		discard;
	}
	gl_FragDepth = log2(depth) * OneOverLog2FarDepthFromNearPlusOne;
}

vec3 computeNormal(in vec3 oriVertex)
{
	vec3 normal = cross(vec3(dFdx(oriVertex.x), dFdx(oriVertex.y), dFdx(oriVertex.z)), vec3(dFdy(oriVertex.x), dFdy(oriVertex.y), dFdy(oriVertex.z)));
	normal = normalize(normal);
	return normal;
}

void main()
{

	vec4 FragColor = vec4(1.0,1.0,1.0,1.0);

	float lightFactor = dot(v_Normal, LightDir);
	
	if(BRadarFlatLoc_BlendColor.y > 0.5)
	{
		vec4 finalColor = texture(radar_ColorTable, vec2(0.5, v_textCoord.x));
	    vec3 blendColor = vec3(finalColor.xyz * (1.0 - UniformColor.a) + UniformColor.rgb * UniformColor.a);
		FragColor = vec4(blendColor * (1.0 - lightFactor)  + lightFactor * LightColor.xyz*LightColor.w,UniformColor.a);
	}
	else
	{
	  FragColor = UniformColor;
	}

    out_FragColor = FragColor;

	if (EnableLogDepth) {
      writeLogDepth(v_depthFromNearPlusOne); 
    }
}
in vec4 Position;
in vec3 Normal;

out vec2  v_textCoord;
out vec2  v_AZ_PitchR;
out vec3  v_Normal;
out float v_depthFromNearPlusOne;



void vertexLogDepth()
{
   v_depthFromNearPlusOne = (gl_Position.w - CurrentFrustum.x) + 1.0; 
}

float absolute(float a)
{
	return a < 0.0 ? -a : a;
}

vec3 AngleToWorldPoint(float radius, float sinDir, float cosDir, float sinEle, float cosEle,float dEleR)
{
    vec3 earthPnt;
	
    if(BRadarFlatLoc_BlendColor.x > 0.5)
	{
	  if(MissParameter_Radius_Pos.x > 0.5)
	  {
	      //дїЇд»°и§’дёє0еє¦зљ„жѓ…е†µдё‹,и®Ўз®—ењ†зЋЇ
		  if(dEleR == 0.0)
		  {
			 earthPnt = vec3(radius * sinDir, radius * cosDir, 0.0); 
		  }
		  else{
		     //е…¶д»–зљ„и§’еє¦дё‹пјЊй»и®¤дёє0.0;
			 earthPnt = vec3(0.0,0.0, 0.0);
		  } 
	  }
	  else{
	  
	    if(dEleR == 15.0*DTOR)
		{
		  earthPnt = vec3(radius * sinDir, radius * cosDir, 0.0);   
		}
		else{
		  earthPnt = vec3(0.0,0.0, 0.0);
		}	
	  }
	  
	}
	else{
	  earthPnt = vec3(radius * sinDir * cosEle, radius * cosDir * cosEle, radius * sinEle);
	}
	
	return earthPnt;
}

float distanceEarthSurface(float lat1Rad, float lon1Rad, float lat2Rad, float lon2Rad, float radius)
{
	float dLat = (lat2Rad - lat1Rad);
	float dLon = (lon2Rad - lon1Rad);
	float a = sin(dLat / 2.0) * sin(dLat / 2.0) + cos(lat1Rad) * cos(lat2Rad) *sin(dLon / 2.0) * sin(dLon / 2.0);
	float c = 2.0 * atan(sqrt(a),sqrt(1.0 - a));
	float d = radius * c;
	return d;
}

float distanceEarthS(vec2 radarLonLatRad,vec2 disturbLonLatRad)
{
	float length = distanceEarthSurface(radarLonLatRad.y, radarLonLatRad.x,disturbLonLatRad.y, disturbLonLatRad.x, 6378137.0);
	return length;
}

float rhumbBearing(float lat1Rad, float lon1Rad, float lat2Rad, float lon2Rad)
{
	float dLon = lon2Rad - lon1Rad;
	float dPhi = log(tan(lat2Rad / 2.0 + MAGNETICS_PI / 4.0) / tan(lat1Rad / 2.0 + MAGNETICS_PI / 4.0));
	if (absolute(dLon) > MAGNETICS_PI) dLon = dLon > 0.0 ? -(2.0 * MAGNETICS_PI - dLon) : (2.0 * MAGNETICS_PI + dLon);
	float brng = atan(dLon,dPhi);
	return mod(brng + 2.0 * MAGNETICS_PI, 2.0 * MAGNETICS_PI);
}


float GetDistance(in float dSinEleR, in float dCosEleR, out float dPercent1)
{
	float dividend = Pt_Gt_lanBuda_thegema.x * pow(Pt_Gt_lanBuda_thegema.y, 2.0) * pow(Pt_Gt_lanBuda_thegema.z, 2.0) * Pt_Gt_lanBuda_thegema.w * sqrt(N_K_Bn_Fn.x);
	float divider = pow(4.0 * MAGNETICS_PI, 3.0) * N_K_Bn_Fn.y * SDeltaN_T0_GridStepAngle.y * N_K_Bn_Fn.z * N_K_Bn_Fn.w * SDeltaN_T0_GridStepAngle.x;
	
	float RE = sqrt(sqrt(dividend / divider));

	float  RD = sqrt(sqrt(abs(dSinEleR))) * dCosEleR * dCosEleR;

	dPercent1 = RD / 0.7;
	return RE * RD;
}

float GetDistance_Disturb(in float dSinEleR, in float dCosEleR, in float dDirR, out float dPercent1)
{
	//й›·иѕѕзљ„дё»и¦ЃеЏ‚ж•°
	float dividend = Pt_Gt_lanBuda_thegema.x * pow(Pt_Gt_lanBuda_thegema.y, 2.0) * pow(Pt_Gt_lanBuda_thegema.z, 2.0) * Pt_Gt_lanBuda_thegema.w * sqrt(N_K_Bn_Fn.x);

	float divider = 0.0;
	
	for (int i = 0; i < NumDisturb; i++)
	{
		RadarDisturbMsg disMsg = Radar_DisturbMsgs[i];
		
		vec2 radarLonLatRad =   vec2(MissParameter_Radius_Pos.z, MissParameter_Radius_Pos.w);
		vec2 disturbLonLatRad = vec2(disMsg.Pos.x, disMsg.Pos.y);
        
		float Rj = distanceEarthS(radarLonLatRad,disturbLonLatRad);
		float theta = rhumbBearing(radarLonLatRad.y,radarLonLatRad.x, disturbLonLatRad.y, disturbLonLatRad.x);
		
		float angle = abs(dDirR - theta);
		if (angle > MAGNETICS_PI)
		{
			angle = MAGNETICS_PI * 2.0 - angle;
		}
		theta = RTOD * angle;
		
		float Gt = 0.0;

		if (0.0 <= theta && theta <= disMsg.Theta_Half * 0.5)
		{
			Gt = Pt_Gt_lanBuda_thegema.y;
		}
		else if (disMsg.Theta_Half * 0.5 <= theta && theta <= 90.0)
		{
			Gt = Pt_Gt_lanBuda_thegema.y * disMsg.K * pow((disMsg.Theta_Half / theta), 2.0);
		}
		else
		{
			Gt = Pt_Gt_lanBuda_thegema.y * disMsg.K * pow((disMsg.Theta_Half / 90.0), 2.0);
		}

		divider += disMsg.Pj * disMsg.Gj * Gt * N_K_Bn_Fn.z * disMsg.Yj / (disMsg.Bj * pow(Rj, 2.0));
	}

	divider = divider * 4.0 * MAGNETICS_PI;
	
	float RE = sqrt(sqrt(dividend / divider));
	float RD = sqrt(sqrt(abs(dSinEleR))) * dCosEleR * dCosEleR;
	
	dPercent1 = RD / 0.7;
	
	return RE * RD ;
}


float GetDistance_Disturb_NoRadarMsg(in float radius, in float dSinEleR, in float dCosEleR, in float dDirR,in float dEleR, out float dPercent1)
{	   
	 
	//й›·иѕѕзљ„дё»и¦ЃеЏ‚ж•°
	float dividend = radius;

	float divider = 0.0;
	
	for (int i = 0; i < NumDisturb; i++)
	{
		RadarDisturbMsg disMsg = Radar_DisturbMsgs[i];
		
		vec2 radarLonLatRad =   vec2(MissParameter_Radius_Pos.z, MissParameter_Radius_Pos.w);
		vec2 disturbLonLatRad = vec2(disMsg.Pos.x, disMsg.Pos.y);
        
		float Rj = distanceEarthS(radarLonLatRad,disturbLonLatRad);
		float theta = rhumbBearing(radarLonLatRad.y,radarLonLatRad.x, disturbLonLatRad.y, disturbLonLatRad.x);
		
		float angle = abs(dDirR - theta);
		if (angle > MAGNETICS_PI)
		{
			angle = MAGNETICS_PI * 2.0 - angle;
		}
		theta = RTOD * angle;
		
		float Gt = 0.0;

		if (0.0 <= theta && theta <= disMsg.Theta_Half * 0.5)
		{
			Gt = 1.0;
		}
		else if (disMsg.Theta_Half * 0.5 <= theta && theta <= 90.0)
		{
			Gt = disMsg.K * pow((disMsg.Theta_Half / theta), 2.0);
		}
		else
		{
			Gt = disMsg.K * pow((disMsg.Theta_Half / 90.0), 2.0);
		}

		divider += disMsg.Pj * disMsg.Gj * Gt *4.0* disMsg.Yj / (disMsg.Bj * pow(Rj, 2.0));
	}

    
   
	 if(NumDisturb != 0 )
	 {
	    float RD = sqrt(sqrt(abs(dSinEleR))) * dCosEleR * dCosEleR;
        //dPercent1 = 1.0 - RD / 0.7;
		
		dPercent1 = 1.0 - abs(dEleR+ MAGNETICS_PI *0.5) / MAGNETICS_PI;
	 
	    divider = divider * 4.0 * MAGNETICS_PI;
	    float RE = sqrt(sqrt(dividend / divider));
		if(RE > dividend)
		{
		    RE = dividend;
		}
		return RE;
	 }
	 else{
	 
	     float RD = sqrt(sqrt(abs(dSinEleR))) * dCosEleR * dCosEleR;
		// dPercent1 = 1.0- RD / 0.7;
		 
	     dPercent1 = 1.0 - abs(dEleR + MAGNETICS_PI*0.5) / 3.1415926;
	     return dividend ;
	 }
	

}


		
void main()
{
    //Position.x = sinDir ;Position.y = cosDir; Position.z =  sinEle; Position.w = cosEle;
	//Normal.x = dDirR ,Normal.y = dEleR ,Normal.z = 0.0 з”ЁжќҐеЊєе€†meshе’ЊиЎҐдёЃ;
	
	vec4 PositionTemp = Position;
	vec3 NormalTemp = Normal;
	
	float AZStartAngle = AZS_AZE_PitchS_PitchE.x;
	float AZEndAngle = AZS_AZE_PitchS_PitchE.y;
	
	bool judgeAZStart = abs(AZStartAngle) < 0.00001;
	bool judgeAZEnd = abs(AZEndAngle- MAGNETICS_2PI) < 0.00001;
	
	int bResult = -1;
	if(judgeAZStart == true && judgeAZEnd == true)
	{
	   if(NormalTemp.x < 0.0)
	   {
	      NormalTemp.x = 0.0;
		  PositionTemp.x = sin(0.0);
		  PositionTemp.y = cos(0.0);
	   }
	   
	   if(NormalTemp.x > MAGNETICS_2PI)
	   {
	      NormalTemp.x = MAGNETICS_2PI;
		  PositionTemp.x = sin(MAGNETICS_2PI);
		  PositionTemp.y = cos(MAGNETICS_2PI);
	   } 
	}

	if((NormalTemp.x < AZStartAngle)|| (NormalTemp.x > AZEndAngle) )
	{
	     NormalTemp = vec3(0.0);
	     PositionTemp = vec4(0.0);  
	}	
	
	if((NormalTemp.y < AZS_AZE_PitchS_PitchE.z)|| (NormalTemp.y > AZS_AZE_PitchS_PitchE.w) )
	{
	   NormalTemp = vec3(0.0);
	   PositionTemp = vec4(0.0);
	}	
	
	float dPercent1 = 0.0;
	float disRadar =  0.0;
	
	if(MissParameter_Radius_Pos.x < 0.5)
	{
	   if(NumDisturb > 0)
	   {
	     float disMax = GetDistance(PositionTemp.z,PositionTemp.w,dPercent1);
		 disRadar = GetDistance_Disturb(PositionTemp.z,PositionTemp.w,NormalTemp.x,dPercent1);
		 if(disRadar > disMax)
		 {
		    disRadar= disMax;
		 }   
	   }
	   else
	   {
	     disRadar = GetDistance(PositionTemp.z,PositionTemp.w,dPercent1);
	   }  
	}
	else
	{
	   disRadar = GetDistance_Disturb_NoRadarMsg(MissParameter_Radius_Pos.y,PositionTemp.z,PositionTemp.w,NormalTemp.x,NormalTemp.y,dPercent1);  
	}
	
    vec3 modelPoint = AngleToWorldPoint(disRadar,PositionTemp.x,PositionTemp.y,PositionTemp.z,PositionTemp.w,NormalTemp.y);
	if(modelPoint == vec3(0.0,0.0,0.0))
	{
	   v_Normal = vec3(1.0,0.,0.0);
	}
	else{
	    v_Normal = normalize(modelPoint);
	}
	
    gl_Position =  ProjectionMatrix *ViewMatrix * ModelMatrix* vec4(modelPoint.z,modelPoint.x,modelPoint.y, 1.0);
	
	if (EnableLogDepth) {
		vertexLogDepth();
	}
	
	v_textCoord = vec2(dPercent1,0.9);
	v_AZ_PitchR = vec2(Normal.x,Normal.y);
		
}
precision highp float;
precision highp int;
precision highp sampler2D;

#ifdef USE_UBO
#define UNIFORM_DECL_PREFIX
#else
#define UNIFORM_DECL_PREFIX uniform
#endif

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
#define SAMPLER_DECL_PREFIX
#else
#define SAMPLER_DECL_PREFIX uniform
#endif

#define MAGNETICS_PI 3.14159265
#define DTOR  0.017453292
#define RTOD  57.295780490


#if defined(USE_UBO)
layout(std140) uniform trit_ShaderParameters_UBO {
#endif

    // These are used in the vertex shader
    UNIFORM_DECL_PREFIX mat4 ModelMatrix;
    UNIFORM_DECL_PREFIX mat4 ViewMatrix;
    UNIFORM_DECL_PREFIX mat4 ProjectionMatrix;
    UNIFORM_DECL_PREFIX bool EnableLogDepth;
    UNIFORM_DECL_PREFIX vec2 CurrentFrustum;
    UNIFORM_DECL_PREFIX float FarDepthFromNearPlusOne;
    UNIFORM_DECL_PREFIX float OneOverLog2FarDepthFromNearPlusOne;
	
	UNIFORM_DECL_PREFIX vec4 UniformColor;
    	
#if defined(USE_UBO)
};
#endif

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
layout(std140) uniform trit_TextureHandles_UBO {
#endif
  SAMPLER_DECL_PREFIX sampler2D radar_ColorTable;

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
};
#endif


in float v_depthFromNearPlusOne;

out vec4 out_FragColor;
 
void writeLogDepth(float depth)
{
   if (depth <= 0.9999999 || depth > FarDepthFromNearPlusOne) {
		discard;
	}
	gl_FragDepth = log2(depth) * OneOverLog2FarDepthFromNearPlusOne;
}

void main()
{
    out_FragColor = UniformColor;

	if (EnableLogDepth) {
      writeLogDepth(v_depthFromNearPlusOne); 
    }
}
in vec3 Position;

out float v_depthFromNearPlusOne;

void vertexLogDepth()
{
   v_depthFromNearPlusOne = (gl_Position.w - CurrentFrustum.x) + 1.0; 
}

void main()
{
    gl_Position =  ProjectionMatrix *ViewMatrix * ModelMatrix* vec4(Position.x,Position.y,Position.z, 1.0);

	if (EnableLogDepth) {
		vertexLogDepth();
	}		
}
precision highp float;
precision highp int;
precision highp sampler2D;

#ifdef USE_UBO
#define UNIFORM_DECL_PREFIX
#else
#define UNIFORM_DECL_PREFIX uniform
#endif

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
#define SAMPLER_DECL_PREFIX
#else
#define SAMPLER_DECL_PREFIX uniform
#endif

#define MAGNETICS_PI 3.14159265
#define DTOR  0.017453292
#define RTOD  57.295780490


#if defined(USE_UBO)
layout(std140) uniform trit_ShaderParameters_UBO {
#endif

    // These are used in the vertex shader
    UNIFORM_DECL_PREFIX mat4 ModelMatrix;
    UNIFORM_DECL_PREFIX mat4 ViewMatrix;
    UNIFORM_DECL_PREFIX mat4 ProjectionMatrix;
    UNIFORM_DECL_PREFIX bool EnableLogDepth;
    UNIFORM_DECL_PREFIX vec2 CurrentFrustum;
    UNIFORM_DECL_PREFIX float FarDepthFromNearPlusOne;
    UNIFORM_DECL_PREFIX float OneOverLog2FarDepthFromNearPlusOne;
	
	UNIFORM_DECL_PREFIX float StartWidth;
	UNIFORM_DECL_PREFIX float EndWidth;
	UNIFORM_DECL_PREFIX float Length;
	UNIFORM_DECL_PREFIX vec3  Time_Kadu_WaveType;
	
	UNIFORM_DECL_PREFIX float Radius;
	UNIFORM_DECL_PREFIX float WidthAngle;
	UNIFORM_DECL_PREFIX float HeightAngle;
	
	UNIFORM_DECL_PREFIX vec4 UniformColor;
    	
#if defined(USE_UBO)
};
#endif

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
layout(std140) uniform trit_TextureHandles_UBO {
#endif
  SAMPLER_DECL_PREFIX sampler2D ColorTable;

#if defined(USE_UBO) && defined(BINDLESS_TEXTURES)
};
#endif


in float v_depthFromNearPlusOne;
in vec2  v_texCoord;

out vec4 out_FragColor;
 
void writeLogDepth(float depth)
{
   if (depth <= 0.9999999 || depth > FarDepthFromNearPlusOne) {
		discard;
	}
	gl_FragDepth = log2(depth) * OneOverLog2FarDepthFromNearPlusOne;
}

void main()
{
    vec4 finalColor = texture(ColorTable, vec2(v_texCoord.x,(v_texCoord.y - Time_Kadu_WaveType.x)/Time_Kadu_WaveType.y));
	
    vec3 whiteColor = vec3(1.0);
	vec3 result = whiteColor*v_texCoord.y + UniformColor.xyz *(1.0 - v_texCoord.y);
	
	if(Time_Kadu_WaveType.z > 0.5)
	{
	  out_FragColor = vec4(result.xyz,UniformColor.w);
	}
	else
	{
	    out_FragColor = vec4(result.xyz,finalColor.w * UniformColor.w);
	}
   
	if (EnableLogDepth) {
      writeLogDepth(v_depthFromNearPlusOne); 
    }
}
in vec4 Position;
in vec4 TexCoord;

out float v_depthFromNearPlusOne;
out vec2  v_texCoord;

void vertexLogDepth()
{
   v_depthFromNearPlusOne = (gl_Position.w - CurrentFrustum.x) + 1.0; 
}

void main()
{ 
    vec3 pointTemp = vec3(0.0);

	if(Time_Kadu_WaveType.z < 0.5)
	{
	   if(Position.w  < 0.0)
		{
		  pointTemp =vec3(StartWidth * Position.x, 0.0, StartWidth * Position.z);
		}
		else
		{
		  pointTemp = vec3(EndWidth * Position.x,Length* Position.y, EndWidth * Position.z);
		}
		
		v_texCoord = vec2(TexCoord.xy);	
	}
	else{
	    
		float length = Radius * tan(HeightAngle * DTOR *0.5);
	
	    if(Position.w  < 0.0)
		{
		  pointTemp = vec3( Position.y * length,Radius * Position.x, Radius * Position.z);
		}
		else
		{
		   pointTemp = vec3(Position.y * length,Radius * Position.x, Radius * Position.z);
	    }
		
		v_texCoord = vec2(TexCoord.xz);
		
		 if(abs(TexCoord.w) > WidthAngle*0.5 )
		 {
			 pointTemp = vec3(0.0);
		 }

	}
	
    gl_Position =  ProjectionMatrix *ViewMatrix * ModelMatrix* vec4(pointTemp.x,pointTemp.y,pointTemp.z, 1.0);

	if (EnableLogDepth) {
		vertexLogDepth();
	}	

    
